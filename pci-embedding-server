#!/bin/sh
set -eu

: "${PROJECT_CODE_INTELLIGENCE_LLAMA_MODEL:=}"
: "${PROJECT_CODE_INTELLIGENCE_EMBEDDING_HOST:=127.0.0.1}"
: "${PROJECT_CODE_INTELLIGENCE_EMBEDDING_PORT:=18081}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_DIR:=}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER:=llama-server}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_CTX:=40960}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_BATCH:=2048}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_UBATCH:=1024}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_PARALLEL:=8}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_N_GPU_LAYERS:=}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_KV_UNIFIED:=1}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_CACHE_PROMPT:=0}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_CACHE_RAM:=0}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_CACHE_IDLE_SLOTS:=0}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_WEBUI:=0}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_LOG_VERBOSITY:=}"
: "${PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_EXTRA_ARGS:=}"

resolve_command() {
	if command -v "$1" >/dev/null 2>&1; then
		command -v "$1"
	elif [ -x "$1" ]; then
		printf '%s\n' "$1"
	else
		return 1
	fi
}

if [ -n "$PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_DIR" ] && [ "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER" = "llama-server" ]; then
	PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER="$PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_DIR/llama-server"
fi

if ! PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_RESOLVED=$(resolve_command "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER"); then
	cat >&2 <<EOF
llama.cpp server binary was not found or is not executable:
  $PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER

Put llama-server on PATH, source your shell config if PATH was just updated,
or set PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER=/path/to/llama-server.

You can also set PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_DIR=/path/to/llama.cpp/bin.
EOF
	exit 1
fi

if [ -z "$PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_DIR" ]; then
	PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_DIR=$(dirname "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_RESOLVED")
fi

if [ -z "$PROJECT_CODE_INTELLIGENCE_LLAMA_MODEL" ] || [ ! -f "$PROJECT_CODE_INTELLIGENCE_LLAMA_MODEL" ]; then
	cat >&2 <<EOF
llama.cpp embedding model was not found:
  ${PROJECT_CODE_INTELLIGENCE_LLAMA_MODEL:-<unset>}

Set PROJECT_CODE_INTELLIGENCE_LLAMA_MODEL=/path/to/embedding-model.gguf.
EOF
	exit 1
fi

export LD_LIBRARY_PATH="$PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

extra_args=""
if [ -n "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_PARALLEL" ]; then
	extra_args="$extra_args --parallel $PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_PARALLEL"
fi
if [ -n "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_N_GPU_LAYERS" ]; then
	extra_args="$extra_args --n-gpu-layers $PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_N_GPU_LAYERS"
fi
if [ "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_KV_UNIFIED" = "1" ]; then
	extra_args="$extra_args --kv-unified"
fi
if [ "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_CACHE_PROMPT" = "0" ]; then
	extra_args="$extra_args --no-cache-prompt"
fi
if [ -n "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_CACHE_RAM" ]; then
	extra_args="$extra_args --cache-ram $PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_CACHE_RAM"
fi
if [ "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_CACHE_IDLE_SLOTS" = "0" ]; then
	extra_args="$extra_args --no-cache-idle-slots"
fi
if [ "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_WEBUI" = "0" ]; then
	extra_args="$extra_args --no-webui"
fi
if [ -n "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_LOG_VERBOSITY" ]; then
	extra_args="$extra_args --log-verbosity $PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_LOG_VERBOSITY"
fi
extra_args="$extra_args $PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_EXTRA_ARGS"

# shellcheck disable=SC2086
exec "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_RESOLVED" \
	--embedding \
	--model "$PROJECT_CODE_INTELLIGENCE_LLAMA_MODEL" \
	--pooling last \
	--host "$PROJECT_CODE_INTELLIGENCE_EMBEDDING_HOST" \
	--port "$PROJECT_CODE_INTELLIGENCE_EMBEDDING_PORT" \
	--ctx-size "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_CTX" \
	--batch-size "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_BATCH" \
	--ubatch-size "$PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_UBATCH" \
	$extra_args \
	--no-warmup
