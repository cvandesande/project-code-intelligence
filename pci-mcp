#!/bin/sh
export PYTHONDONTWRITEBYTECODE=1
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
export PROJECT_CODE_INTELLIGENCE_COLLECTION="${PROJECT_CODE_INTELLIGENCE_COLLECTION:-default}"
export PYTHONPATH="$SCRIPT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
: "${PYTHON:=python3}"
exec "$PYTHON" -m project_code_intelligence.server "$@"
