# Preferred host-tool database setting. Leave commented to use the local Compose
# defaults below. Include host, port, database, and optional query parameters
# such as sslmode. Credentials may be included here or provided separately.
# PROJECT_CODE_INTELLIGENCE_DATABASE_URL=postgresql://codeintel:codeintel@127.0.0.1:5433/codeintel?sslmode=prefer
# PROJECT_CODE_INTELLIGENCE_DATABASE_USER=codeintel
# PROJECT_CODE_INTELLIGENCE_DATABASE_PASSWORD=codeintel

# Local Docker Compose database settings. Docker Compose uses these to create
# the pgvector container. Host tools use them only when
# PROJECT_CODE_INTELLIGENCE_DATABASE_URL is unset.
PGVECTOR_DB=codeintel
PGVECTOR_USER=codeintel
PGVECTOR_PASS=codeintel
PGVECTOR_PORT=5433

# Host-tool DB connections are intentionally short-lived during long embedding
# runs. These bounds make laptop network changes fail quickly and resume cleanly
# on the next pci-index run.
PROJECT_CODE_INTELLIGENCE_DB_CONNECT_TIMEOUT_SECONDS=10
PROJECT_CODE_INTELLIGENCE_DB_RETRIES=3

# MCP query safety limits. These apply to each stdio MCP tool request so an
# assistant query cannot hang indefinitely on an expensive database plan.
PROJECT_CODE_INTELLIGENCE_MCP_STATEMENT_TIMEOUT_MS=60000
PROJECT_CODE_INTELLIGENCE_MCP_LOCK_TIMEOUT_MS=5000
PROJECT_CODE_INTELLIGENCE_MCP_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
PROJECT_CODE_INTELLIGENCE_MCP_MAX_REQUEST_BYTES=4194304
PROJECT_CODE_INTELLIGENCE_MCP_MAX_RECORD_CONTENT_CHARS=32768

# Compose publishes local services on loopback by default. Set to 0.0.0.0 only
# when intentionally exposing Postgres or embedding endpoints to other hosts.
PROJECT_CODE_INTELLIGENCE_BIND_HOST=127.0.0.1

# Local CPU, NPU, and GPU embedding services all publish this same host port.
# Run only one local embedding service at a time.
PROJECT_CODE_INTELLIGENCE_EMBEDDING_PORT=18081

# Optional external OpenAI-compatible embedding provider. Remote providers
# receive source-derived text, so they require an explicit privacy opt-in.
# OpenAI can use OPENAI_API_KEY; Voyage can use VOYAGE_API_KEY. The generic key
# below takes precedence when set.
PROJECT_CODE_INTELLIGENCE_EMBEDDING_ENDPOINT=
PROJECT_CODE_INTELLIGENCE_EMBEDDING_ENDPOINT_MODEL=
PROJECT_CODE_INTELLIGENCE_EMBEDDING_API_KEY=
PROJECT_CODE_INTELLIGENCE_ALLOW_REMOTE_EMBEDDING=0
PROJECT_CODE_INTELLIGENCE_EMBEDDING_REQUEST_TIMEOUT_SECONDS=300
PROJECT_CODE_INTELLIGENCE_EMBEDDING_REQUEST_RETRIES=3

# CPU FastEmbed profile. Jina is the default quality-oriented CPU model. For a
# smaller and faster CPU demo, set this to BAAI/bge-small-en-v1.5.
# The container downloads model files into a Docker volume, not into the repo.
PROJECT_CODE_INTELLIGENCE_FASTEMBED_MODEL=jinaai/jina-embeddings-v2-base-code

# Experimental AMD Ryzen AI NPU profile. The Lemonade container uses the host
# /dev/accel/accel0 device and stores downloaded models in Docker volumes.
PROJECT_CODE_INTELLIGENCE_LEMONADE_IMAGE=ghcr.io/lemonade-sdk/lemonade-server:latest

# Current Lemonade FLM NPU embedding model. Host tools and MCP clients should
# pass this as PROJECT_CODE_INTELLIGENCE_EMBEDDING_ENDPOINT_MODEL when using the
# npu profile.
PROJECT_CODE_INTELLIGENCE_LEMONADE_EMBEDDING_MODEL=embed-gemma-300m-FLM

# AMD ROCm llama.cpp profile. Leave release as latest to use Lemonade's current
# GitHub release, or pin a tag such as b1264 for reproducibility.
PROJECT_CODE_INTELLIGENCE_ROCM_BASE_IMAGE=debian:stable-slim
PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_ROCM_RELEASE=latest
PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_ROCM_REPO=lemonade-sdk/llamacpp-rocm

# Apple Silicon Core ML profile. Runs natively on macOS using the Neural Engine,
# GPU, and CPU. Model weights are cached in the Hugging Face Hub directory.
PROJECT_CODE_INTELLIGENCE_COREML_MODEL=ewchampion/Qwen3-Embedding-0.6B-coreml-4bit.mlpackage

# NVIDIA CUDA llama.cpp profile. Requires a host NVIDIA driver plus NVIDIA
# Container Toolkit. The default image is the upstream llama.cpp CUDA server.
PROJECT_CODE_INTELLIGENCE_CUDA_BASE_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Set one of these when automatic ROCm detection is unavailable or ambiguous.
PROJECT_CODE_INTELLIGENCE_AMD_GFX=
PROJECT_CODE_INTELLIGENCE_LLAMA_CPP_ROCM_BUNDLE=

# Advanced llama.cpp embedding model. Model weights are downloaded into ./models
# only when an amdgpu or nvidia GPU profile starts and are not included here.
PROJECT_CODE_INTELLIGENCE_HF_MODEL_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
PROJECT_CODE_INTELLIGENCE_HF_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
PROJECT_CODE_INTELLIGENCE_LLAMA_SERVER_N_GPU_LAYERS=999
